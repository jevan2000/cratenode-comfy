{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "placeholder-clip.mp4"
    }
  },
  "2": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "1",
        0
      ]
    }
  },
  "3": {
    "class_type": "CNCanvas",
    "inputs": {
      "preset": "custom",
      "landscape_flip": false,
      "width": 1280,
      "height": 720,
      "background": "#101420",
      "safe_margin": 5.0
    }
  },
  "4": {
    "class_type": "CNAddVideo",
    "inputs": {
      "mask_meaning": "LoadImage (1 = transparent)",
      "fps": [
        "2",
        2
      ],
      "mode": "fill",
      "x": 640.0,
      "y": 180.0,
      "box_width": 560.0,
      "box_height": 315.0,
      "start": 0.0,
      "loop": true,
      "below_previous": false,
      "gap": 24.0,
      "scene": [
        "3",
        0
      ],
      "frames": [
        "2",
        0
      ]
    },
    "_meta": {
      "title": "Add Video: picture in picture"
    }
  },
  "5": {
    "class_type": "CNAnimate",
    "inputs": {
      "target": "last item",
      "property": "x",
      "keyframes": "0: 700\n0.8: 0",
      "easing": "back out",
      "stagger": 0.0,
      "scene": [
        "4",
        0
      ]
    },
    "_meta": {
      "title": "Keyframes: the video slides in"
    }
  },
  "6": {
    "class_type": "CNShape",
    "inputs": {
      "shape": "star",
      "x": 170.0,
      "y": 200.0,
      "width": 300.0,
      "height": 300.0,
      "color": "#f2b134",
      "stroke_color": "",
      "stroke_width": 0.0,
      "corner_radius": 0.0,
      "sides": 5,
      "inner_ratio": 0.45,
      "rotation": 0.0,
      "below_previous": false,
      "gap": 24.0,
      "scene": [
        "5",
        0
      ]
    }
  },
  "7": {
    "class_type": "CNAnimate",
    "inputs": {
      "target": "last item",
      "property": "rotation",
      "keyframes": "0: 0\n4: 360",
      "easing": "linear",
      "stagger": 0.0,
      "scene": [
        "6",
        0
      ]
    },
    "_meta": {
      "title": "Keyframes: spin"
    }
  },
  "8": {
    "class_type": "CNAnimate",
    "inputs": {
      "target": "last item",
      "property": "scale",
      "keyframes": "0: 0.6\n1: 1.1\n2: 0.9\n3: 1.1\n4: 1",
      "easing": "ease in out",
      "stagger": 0.0,
      "scene": [
        "7",
        0
      ]
    },
    "_meta": {
      "title": "Keyframes: pulse"
    }
  },
  "9": {
    "class_type": "CNTextBox",
    "inputs": {
      "text": "KEYFRAMES",
      "font": "Montserrat",
      "font_override": "",
      "weight": 800,
      "bold_weight": 900,
      "italic": false,
      "size": 72.0,
      "color": "#ffffff",
      "align": "center",
      "valign": "top",
      "case": "as typed",
      "x": 0.0,
      "y": 560.0,
      "box_width": 1280.0,
      "box_height": 0.0,
      "auto_fit": false,
      "min_size": 12.0,
      "line_height": 1.15,
      "letter_spacing": 0.0,
      "below_previous": false,
      "gap": 24.0,
      "scene": [
        "8",
        0
      ]
    }
  },
  "10": {
    "class_type": "CNAnimate",
    "inputs": {
      "target": "last item",
      "property": "wipe",
      "keyframes": "0.5: 0\n1.5: 1",
      "easing": "ease out",
      "stagger": 0.0,
      "scene": [
        "9",
        0
      ]
    },
    "_meta": {
      "title": "Keyframes: letter wipe"
    }
  },
  "11": {
    "class_type": "CNTimeline",
    "inputs": {
      "duration": 4.0,
      "fps": 24.0,
      "scene": [
        "10",
        0
      ]
    }
  },
  "12": {
    "class_type": "CNRenderAnimation",
    "inputs": {
      "scale": 0.5,
      "fps": 0.0,
      "start_frame": 0,
      "max_frames": 0,
      "every_nth": 1,
      "scene": [
        "11",
        0
      ]
    },
    "_meta": {
      "title": "Render Animation: frames as a batch"
    }
  },
  "13": {
    "class_type": "PreviewImage",
    "inputs": {
      "images": [
        "12",
        0
      ]
    },
    "_meta": {
      "title": "Every frame (batch)"
    }
  },
  "14": {
    "class_type": "CNSaveVideo",
    "inputs": {
      "format": "mp4 (H.264)",
      "fps": [
        "12",
        2
      ],
      "quality": 80,
      "scale": 1.0,
      "matte": "#000000",
      "filename_prefix": "cratenode/motion/keyframes",
      "images": [
        "12",
        0
      ],
      "alpha": [
        "12",
        1
      ]
    },
    "_meta": {
      "title": "Save Video from the frame batch"
    }
  }
}